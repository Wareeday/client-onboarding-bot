# Copy to `.env` and configure only the integrations you want to enable.
# Local mode (`python3 main.py`) requires ZERO credentials or external packages.

# --- Runtime & Storage Overrides (Optional) ---
# ONBOARDING_CONFIG=config.yaml
# ONBOARDING_OUTPUT_DIR=output
# ONBOARDING_DB_PATH=output/state/onboarding.db
# ONBOARDING_LOG_LEVEL=INFO

# --- Google Drive Workspace Provisioning (`--mode gdrive`) ---
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- Email Delivery (`--send-emails`) ---
# Option A: Gmail App Password (zero extra config needed)
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Option B: Generic Production SMTP (overrides Gmail defaults when SMTP_HOST is set)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_secret
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_FROM=onboarding@yourdomain.com

# --- Team Notifications (`--notify-webhook`) ---
# Supports Slack Incoming Webhooks, Discord Webhooks, or Generic JSON endpoints.
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# WEBHOOK_FORMAT=auto  # auto | slack | discord | generic
